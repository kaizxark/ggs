{
  "outputDirectory": "dist/public",
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/app.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(logo|favicon|apple-touch-icon)(-[0-9]+)?\\.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/app.html" },
    { "source": "/dashboard", "destination": "/app.html" },
    { "source": "/reset-password", "destination": "/app.html" },
    { "source": "/((?!api/|assets/|app\\.html).*)", "destination": "/app.html" }
  ]
}
