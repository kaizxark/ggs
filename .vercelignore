# Local-only tooling — never upload.
# scripts/seed-erp.mjs embeds the Supabase service-role key.
# The landing export and its mobile navigation helper are required at build time.
scripts/*
!scripts/serve-webflow-export.mjs
!scripts/mobile-navigation.mjs
# Tests are run locally and in CI, never deployed. Each api/*.test.ts would
# otherwise be compiled as its own Serverless Function and count against the
# Hobby plan's 12-function limit.
**/*.test.ts
**/*.test.tsx
supabase/
tmp/
test.html
*.pdf
.env
.env.*
.freebuff/
.impeccable/
.kilo/
.manus-logs/
server.log
vite.config.ts.bak

# Build output and deps (Vercel builds from source).
dist/
node_modules/

# Vercel + editor metadata
.vercel/
.vscode/
.idea/

# The export is the landing page: the build reads it and copies its assets.
